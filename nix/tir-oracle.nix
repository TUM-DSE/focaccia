{ tir, system, sailTestModule ? null, sailOnly ? false }:
let
  pkgs = import tir.inputs.nixpkgs {
    inherit system;
    overlays = [ (import tir.inputs.rust-overlay) ];
  };
  # Keep the existing ARM/JIT package buildable on its current input while
  # source-profile APIs are merged upstream. Capability is fixed at build time.
  sailAdapter = "${tir}/crates/frontend/src/adapters/sail/mod.rs";
  hasSail = builtins.pathExists sailAdapter
    && pkgs.lib.hasInfix "pub fn x86_64_profile(" (builtins.readFile sailAdapter);
  # Every Sail-enabled bridge build exercises the real pinned model. The
  # explicit override also permits regression tests against older artifacts;
  # ARM-only inputs retain their existing dependency closure.
  sailTestSource = if sailTestModule != null then builtins.path {
    path = sailTestModule;
    name = "focaccia-sail-source-test.tir";
  } else if hasSail then
    "${tir.packages.${system}.sail-x86-specification}/x86.tir"
  else null;
  toolchain = pkgs.rust-bin.nightly.latest.default;
  craneLib = (tir.inputs.crane.mkLib pkgs).overrideToolchain toolchain;
  vendor = craneLib.vendorCargoDeps { cargoLock = "${tir}/Cargo.lock"; };
  # Resolve the bridge inside the fetched workspace using only the crate
  # versions already vendored from TIR's committed lockfile. No sibling checkout
  # or network access is needed by Cargo, including when producing this lockfile.
  source = pkgs.runCommand "focaccia-tir-oracle-source" {
    nativeBuildInputs = [ toolchain ];
  } ''
    mkdir -p "$out/focaccia-oracle" "$TMPDIR/cargo-home"
    cp ${tir}/Cargo.toml ${tir}/Cargo.lock "$out/"
    cp -r ${tir}/src ${tir}/crates "$out/"
    cp -r ${../rust/tir-oracle}/. "$out/focaccia-oracle/"
    chmod -R u+w "$out"
    substituteInPlace "$out/Cargo.toml" \
      --replace-fail '    "crates/tirrt-rt",' '    "crates/tirrt-rt", "focaccia-oracle",'
    export CARGO_HOME="$TMPDIR/cargo-home"
    cp ${vendor}/config.toml "$CARGO_HOME/config.toml"
    cd "$out"
    cargo generate-lockfile --offline
  '';
  args = {
    pname = "focaccia-tir-oracle";
    version = "0.1.0";
    src = source;
    cargoVendorDir = vendor;
    cargoExtraArgs = "--locked -p focaccia-tir-oracle";
    strictDeps = true;
    doCheck = true;
    nativeBuildInputs = [ pkgs.pkg-config pkgs.llvmPackages_18.llvm.dev ];
    buildInputs = [ pkgs.llvmPackages_18.libllvm pkgs.libffi pkgs.libxml2 pkgs.ncurses pkgs.zlib ];
    LLVM_CONFIG_PATH = "${pkgs.llvmPackages_18.llvm.dev}/bin/llvm-config";
    LLVM_SYS_181_PREFIX = "${pkgs.llvmPackages_18.llvm.dev}";
    RUSTFLAGS = "-C link-arg=-rdynamic --check-cfg=cfg(focaccia_sail_only) --check-cfg=cfg(focaccia_sail)"
      + pkgs.lib.optionalString hasSail " --cfg focaccia_sail"
      + pkgs.lib.optionalString sailOnly " --cfg focaccia_sail_only";
    FOCACCIA_TIR_REVISION = tir.rev or "uncommitted-source-override";
  } // pkgs.lib.optionalAttrs (sailTestSource != null) {
    FOCACCIA_SAIL_TEST_MODULE = sailTestSource;
  };
  # The workspace/lockfile are generated by `source`. Let Cargo resolve them
  # during the build, not through mkDummySrc's import-from-derivation at Nix
  # evaluation time: evaluating an x86 package on ARM must not try to execute
  # an x86 Cargo binary merely to discover dependency metadata.
  unwrapped = craneLib.buildPackage (args // { cargoArtifacts = null; });
  prepared = pkgs.runCommand "focaccia-tir-prepared-specification" {
    nativeBuildInputs = [ unwrapped ];
    TIR_ASL_AST = "${tir.packages.${system}.asl-specification}/ast.json";
  } ''
    mkdir -p "$out"
    focaccia-tir-oracle --prepare "$out/module.bin"
  '';
in pkgs.symlinkJoin {
  name = "focaccia-tir-oracle-0.1.0";
  paths = [ unwrapped ];
  nativeBuildInputs = [ pkgs.makeWrapper ];
  postBuild = ''
    wrapProgram "$out/bin/focaccia-tir-oracle" \
      --set-default TIR_ASL_AST "${tir.packages.${system}.asl-specification}/ast.json" \
      --set FOCACCIA_TIR_MODULE "${prepared}/module.bin" \
      --prefix PATH : "${pkgs.coreutils}/bin"
  '';
  passthru.preparedSpecification = prepared;
  meta.mainProgram = "focaccia-tir-oracle";
}
